{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["variants", "recommended_index"],
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "tweets", "rationale", "sources"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 25000 },
          "tweets": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
          },
          "rationale": { "type": "string", "maxLength": 2000 },
          "sources": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "maxLength": 2048 }
          }
        }
      }
    },
    "recommended_index": { "type": "integer", "minimum": 0, "maximum": 2 },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "decision", "reason"],
      "properties": {
        "class": { "type": "string", "maxLength": 60 },
        "decision": { "type": "string", "enum": ["answer", "ignore", "escalate"] },
        "reason": { "type": "string", "maxLength": 600 }
      }
    }
  }
}
