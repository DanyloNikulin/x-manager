{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["report", "observations", "proposals"],
  "properties": {
    "report": { "type": "string", "minLength": 1, "maxLength": 6000 },
    "observations": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "proposals": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "current", "proposed", "rationale", "evidence", "confidence"],
        "properties": {
          "target": {
            "type": "string",
            "enum": ["voice", "strategy", "memory", "playbook", "postsPerDay", "maxRepliesPerConversation"]
          },
          "current": { "type": "string", "maxLength": 2000 },
          "proposed": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidence": { "type": "string", "maxLength": 1000 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
