{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "angle", "pillar", "source_notes"],
        "properties": {
          "topic": { "type": "string", "minLength": 1, "maxLength": 300 },
          "angle": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "pillar": { "type": "string", "maxLength": 200 },
          "source_notes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "note"],
              "properties": {
                "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "note": { "type": "string", "maxLength": 2000 }
              }
            }
          }
        }
      }
    }
  }
}
